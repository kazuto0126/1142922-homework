<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio 2022：建置 > 發佈，選 SingleExe，就會得到不需安裝 .NET、旁邊沒有任何 dll 的單一 exe。 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 不壓縮：壓縮過的大段附加資料容易被防毒軟體的啟發式判斷當成「加殼」而誤報。 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- 交付版不編譯錄影工具（GameForm.Video.cs 的錄影模式）。 -->
    <DefineConstants>$(DefineConstants);RELEASE_EXE</DefineConstants>
    <DebugType>none</DebugType>
    <PublishDir>bin\SingleExe\</PublishDir>
  </PropertyGroup>
</Project>
